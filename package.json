{
  "name": "ijipb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Intelligent Job Interview Preparation Bot (Gemini + Firebase, no server)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:live": "node --env-file=.env.scripts node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "eval:sample": "node --env-file=.env.scripts node_modules/vitest/vitest.mjs run --config vitest.live.config.ts tests/live/sample.live.ts"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vader-sentiment": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
